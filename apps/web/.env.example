DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Required by the Vercel scheduled election-closing endpoint.
CRON_SECRET=replace-with-a-long-random-secret
# A random 32+ character secret used to hash OTP values and rate-limit identifiers.
OTP_HASH_SECRET=replace-with-a-long-random-secret
# Resend API key used by the server to email student OTPs.
RESEND_API_KEY=re_xxxxxxxxx
# Local testing sender. In production, use an address on a verified domain.
RESEND_FROM_EMAIL="NACOS Vote <onboarding@resend.dev>"
# Public app origin used to construct admin password-reset links.
APP_BASE_URL=http://localhost:3000
# Required before `npm run seed:students`; never set this in production.
SEED_DEMO_DATA=false
# Required once before `npm run seed:admin`; never set this in production.
SEED_INITIAL_ADMIN=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.edu.ng
INITIAL_ADMIN_PASSWORD=use-a-unique-password-with-at-least-12-characters

# Candidate portraits. Keep the API secret server-only; do not prefix it with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_CANDIDATE_FOLDER=nacos-vote/candidates
CLOUDINARY_CANDIDATE_UPLOAD_PRESET=nacos_candidate_portrait
